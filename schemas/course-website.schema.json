{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "toolZh": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "titleZh": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "summaryZh": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "outcomeZh": {
      "type": "string",
      "minLength": 1
    },
    "duration": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "string",
      "minLength": 1
    },
    "levelZh": {
      "type": "string",
      "minLength": 1
    },
    "shippedAt": {
      "type": "string",
      "minLength": 1
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "prerequisitesZh": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "searchTerms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^l[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "titleZh": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "objectiveZh": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "titleZh",
          "objective",
          "objectiveZh"
        ],
        "additionalProperties": false
      },
      "minItems": 5,
      "maxItems": 5
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "titleZh": {
            "type": "string",
            "minLength": 1
          },
          "dataFile": {
            "type": "string",
            "minLength": 1
          },
          "blurb": {
            "type": "string",
            "minLength": 1
          },
          "blurbZh": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "titleZh",
          "dataFile",
          "blurb",
          "blurbZh"
        ],
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "methodZh": {
          "type": "string",
          "minLength": 1
        },
        "starterCommand": {
          "type": "string",
          "minLength": 1
        },
        "starterExpectFailure": {
          "type": "string",
          "minLength": 1
        },
        "solutionCommand": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "method",
        "methodZh",
        "starterCommand",
        "starterExpectFailure",
        "solutionCommand"
      ],
      "additionalProperties": false
    },
    "badge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "nameEn": {
          "type": "string",
          "minLength": 1
        },
        "nameZh": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "nameEn",
        "nameZh"
      ],
      "additionalProperties": false
    },
    "difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "agentTool": {
      "type": "boolean"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "live",
        "upcoming"
      ]
    },
    "sharedCoreOf": {
      "type": "string",
      "minLength": 1
    },
    "teachingRunPending": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "tool",
    "toolZh",
    "title",
    "titleZh",
    "summary",
    "summaryZh",
    "outcome",
    "outcomeZh",
    "duration",
    "level",
    "levelZh",
    "shippedAt",
    "prerequisites",
    "prerequisitesZh",
    "searchTerms",
    "lessons",
    "scenarios",
    "verification",
    "badge",
    "difficulty",
    "order",
    "agentTool",
    "aliases"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
